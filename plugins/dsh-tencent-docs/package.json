{
  "name": "@local/dsh-tencent-docs",
  "version": "0.6.0-classroom.1",
  "private": true,
  "type": "module",
  "description": "腾讯文档连接器：会话独立选择启用、本人授权与修改前确认",
  "main": "./lib/index.mjs",
  "exports": {
    ".": "./lib/index.mjs",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "LICENSE",
    "cordis.patch.yml"
  ],
  "dependencies": {
    "@modelcontextprotocol/client": "2.0.0"
  },
  "dsh": {
    "client": {
